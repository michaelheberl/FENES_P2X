  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 2 Energiesystem "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {},
   "outputs": [],
   "source": [
    "zeit = pd.date_range('2023-01-01 00:00:00',\n",
    "                     '2023-12-31 23:00:00',\n",
    "                     freq='60min')\n",
    "                     \n",
    "energysystem = solph.EnergySystem(timeindex=zeit, infer_last_interval=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2.1 Busse"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [],
   "source": [
    "bus_el = solph.buses.Bus(label=\"Strom\")                                           #Einheit: kWh\n",
    "energysystem.add(bus_el)\n",
    "\n",
    "bus_h2 = solph.buses.Bus(label=\"Wasserstoff\")                                     #Einheit: kg\n",
    "energysystem.add(bus_h2)\n",
    "\n",
    "bus_nh3 = solph.buses.Bus(label=\"Ammoniak\")                                       #Einheit: kg\n",
    "energysystem.add(bus_nh3)\n",
    "\n",
    "bus_n2 = solph.buses.Bus(label=\"Stickstoff\")                                      #Einheit: kg\n",
    "energysystem.add(bus_n2)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2.2 Quellen"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [],
   "source": [
    "energysystem.add(\n",
    "    solph.components.Source(\n",
    "        label=\"Wind\",\n",
    "        outputs={bus_el: \n",
    "                 solph.flows.Flow(fix=volllaststunden[\"Wind Patagonien\"],                                                                                                                      # P/Pn = (%)\n",
    "                                  nominal_value = solph.Investment(ep_costs = annuity_wkaon + Eingangsdaten[\"opex_fix_wkaon\"] , maximum=Eingangsdaten[\"ausbaugrenze_wkaon\"]),       # €/kWa + €/kWa     Grenze: kW\n",
    "                                  variable_costs = Eingangsdaten[\"opex_var_wkaon\"]                                                                                                  # €/kWh \n",
    "                                  )}))\n",
    "\n",
    "\n",
    "energysystem.add(\n",
    "    solph.components.Source(\n",
    "        label=\"PV\",\n",
    "        outputs={bus_el: \n",
    "                 solph.flows.Flow(fix=volllaststunden[\"PV Patagonien\"],                                                                                                                        # P/Pn = (%)\n",
    "                                  nominal_value  = solph.Investment(ep_costs = annuity_pv +  Eingangsdaten[\"opex_fix_pv\"] , maximum=Eingangsdaten[\"ausbaugrenze_pv\"]),              # €/kWa + €/kWa     Grenze: kW\n",
    "                                  variable_costs = Eingangsdaten[\"opex_var_pv\"]                                                                                                     # €/kWh\n",
    "                                  )}))\n",
    "    \n",
    "\n",
    "energysystem.add(\n",
    "        solph.components.Source(\n",
    "            label=\"Netzbezug\",\n",
    "            outputs={bus_el: \n",
    "                     solph.flows.Flow(variable_costs=Eingangsdaten[\"strompreis\"])}))                                                                                                # €/kWh         \n",
    "    "
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2.3 Senken"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "metadata": {},
   "outputs": [],
   "source": [
    "energysystem.add(\n",
    "    solph.components.Sink(\n",
    "        label=\"Verkauf_Strom\", \n",
    "        inputs={bus_el: solph.flows.Flow(variable_costs=Eingangsdaten[\"stromerloes\"])}))                 # - €/kWh\n",
    "\n",
    "\n",
    "energysystem.add(\n",
    "    solph.components.Sink(\n",
    "        label=\"Verkauf_Wasserstoff\", \n",
    "        inputs={bus_h2: solph.flows.Flow(variable_costs=Eingangsdaten[\"wasserstofferloes\"])}))           # - €/kg\n",
    "\n",
    "\n",
    "energysystem.add(\n",
    "    solph.components.Sink(\n",
    "        label=\"Verkauf_Ammoniak\", \n",
    "        inputs={bus_nh3: solph.flows.Flow(variable_costs=Eingangsdaten[\"ammoniakerloes\"])}))             # - €/kg"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2.4 Konverter"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "metadata": {},
   "outputs": [],
   "source": [
    "energysystem.add(\n",
    "    solph.components.Converter(\n",
    "        label=\"elektrolyseur\",\n",
    "        inputs={bus_el: solph.flows.Flow(\n",
    "            nominal_value=solph.Investment(ep_costs=annuity_pem + Eingangsdaten[\"capex_pem\"]*Eingangsdaten[\"opex_pem\"] ))},                                 # €/kWa + €/kW * %/a\n",
    "        outputs={bus_h2: solph.flows.Flow()},\n",
    "        conversion_factors={bus_el: Eingangsdaten[\"strombedarf_pem\"], bus_h2: 1},                                                                           # kWh/kg_H2\n",
    "       # non_convex=solph.NonConvex(maximum_uptime=60000),                                                                                                  # Lebensdauer Stack begrenzen\n",
    "        ))                              \n",
    "\n",
    "\n",
    "energysystem.add(\n",
    "    solph.components.Converter(\n",
    "        label=\"haber-bosch\",                                                    \n",
    "        inputs={\n",
    "            bus_el: solph.flows.Flow(),\n",
    "            bus_h2: solph.flows.Flow(),\n",
    "            bus_n2: solph.flows.Flow()},         \n",
    "        outputs={\n",
    "            bus_nh3: solph.flows.Flow(fix=volllaststunden[\"Volllast\"],                                                                                   # P/Pn = 1 \n",
    "                                    nominal_value=Eingangsdaten[\"produktionskapa_hb\"])},                                                                    # kg/h        \n",
    "        conversion_factors={\n",
    "            bus_el: Eingangsdaten[\"strombedarf_hb\"] , bus_h2: Eingangsdaten[\"h2_bedarf_hb\"] ,bus_n2: Eingangsdaten[\"n2_bedarf_hb\"], bus_nh3: 1 },))         # kWh/kg_NH3, kg_H2/kg_NH3, kg_N2/kg_NH3\n",
    "\n",
    "\n",
    "energysystem.add(\n",
    "    solph.components.Converter(\n",
    "        label=\"asu\",\n",
    "        inputs={bus_el: solph.flows.Flow(\n",
    "            nominal_value=solph.Investment(ep_costs= annuity_asu/Eingangsdaten[\"strombedarf_asu\"] + Eingangsdaten[\"capex_asu\"]/Eingangsdaten[\"strombedarf_asu\"] * Eingangsdaten[\"opex_asu\"]))},                 # €*h/(kg*a) *kg/kWh + €*h/kg *kg/kWh * %/a = €h/kWha \n",
    "        outputs={bus_n2: solph.flows.Flow()},\n",
    "        conversion_factors={bus_el: Eingangsdaten[\"strombedarf_asu\"] , bus_n2: 1},))                                                                        # kWh/kg_N2"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2.5 Speicher"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "metadata": {},
   "outputs": [],
   "source": [
    "wasserstofftank = solph.components.GenericStorage(                              \n",
    "    nominal_storage_capacity=solph.Investment(ep_costs = annuity_h2s + Eingangsdaten[\"opex_h2s\"] * Eingangsdaten[\"capex_h2s\"]),               # €*h/(kg*a) + €*h/kg * %/a \n",
    "    label=\"h2s\",\n",
    "    inputs={bus_h2: solph.flows.Flow()},                \n",
    "    outputs={bus_h2: solph.flows.Flow()},                         \n",
    "    loss_rate=Eingangsdaten[\"verlustrate_h2s\"] ,                                                                                              # %_Kapa/h \n",
    "    initial_storage_level=Eingangsdaten[\"fuellstand_h2s\"] ,                                                                                   # %_Kapa\n",
    "    inflow_conversion_factor=Eingangsdaten[\"eta_einspeichern_h2s\"] ,                                                                          # %\n",
    "    outflow_conversion_factor=Eingangsdaten[\"eta_ausspeichern_h2s\"] ,                                                                         # %\n",
    "    invest_relation_input_capacity = 1,                                                                                                       # legt abhängig von Kapazität Ein/Ausspeicherleistung fest / C-Rate\n",
    "    invest_relation_output_capacity= 1,                                          \n",
    ")\n",
    "\n",
    "energysystem.add(wasserstofftank)\n",
    "    \n",
    "  \n",
    "batterie = solph.components.GenericStorage(                              \n",
    "    nominal_storage_capacity=solph.Investment(ep_costs=annuity_bat_kapa + Eingangsdaten[\"c_rate_bat\"] * annuity_bat_leistung),              # €/(kWh*a) + kw/kwh * €/(kW*a) =  €/(kWh*a)                             \n",
    "    label=\"Batterie\",\n",
    "    inputs={bus_el: solph.flows.Flow()},                \n",
    "    outputs={bus_el: solph.flows.Flow()},                         \n",
    "    loss_rate = Eingangsdaten[\"verlustrate_bat\"]/24,                                                                                        # %/d * d/24h = %/h\n",
    "    initial_storage_level=Eingangsdaten[\"fuellstand_bat\"] ,                                                                                 # %_Kapa\n",
    "    inflow_conversion_factor=Eingangsdaten[\"eta_einspeichern_bat\"] ,                                                                        # %\n",
    "    outflow_conversion_factor= Eingangsdaten[\"eta_ausspeichern_bat\"] ,                                                                      # %\n",
    "    invest_relation_input_capacity = Eingangsdaten[\"c_rate_bat\"],                                                                           # kW/kWh\n",
    "    invest_relation_output_capacity= Eingangsdaten[\"c_rate_bat\"],                                   \n",
    ")\n",
    "\n",
    "energysystem.add(batterie)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2.6 Modellauf"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "metadata": {},
   "outputs": [],
   "source": [
    "model = solph.Model(energysystem)\n",
    "model.solve(solver='gurobi')\n",
    "Ergebnisse = solph.processing.results(model)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 3 Postprocessing"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3.1 Auslesen der Ergebnisse"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3.1.1 Busse"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Keine weitere extraktion, da selben ergebnisse wie unten bei Quellen, Konverter, Speicher und Senken\n",
    "result_strombus = solph.views.node(Ergebnisse, 'Strom')\n",
    "result_h2bus = solph.views.node(Ergebnisse, 'Wasserstoff')\n",
    "result_n2bus = solph.views.node(Ergebnisse, 'Stickstoff')\n",
    "result_nh3bus = solph.views.node(Ergebnisse, 'Ammoniak')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3.1.2 Quellen"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "metadata": {},
   "outputs": [],
   "source": [
    "result_strombezug = solph.views.node(Ergebnisse, 'Netzbezug')\n",
    "result_strombezug_flow = result_strombezug['sequences'][(('Netzbezug', 'Strom'), 'flow')]   # kWh/h\n",
    "\n",
    "result_wka = solph.views.node(Ergebnisse, 'Wind')\n",
    "result_wka_invest = result_wka['scalars'][(('Wind', 'Strom'), 'invest')]                    # ? gleiche wie total\n",
    "result_wka_leistung = result_wka['scalars'][(('Wind', 'Strom'), 'total')]                   # kW\n",
    "result_wka_flow_generation = result_wka['sequences'][(('Wind', 'Strom'), 'flow')]           # kWh/h\n",
    "\n",
    "result_pv = solph.views.node(Ergebnisse, 'PV')\n",
    "result_pv_invest = result_pv['scalars'][(('PV', 'Strom'), 'invest')]                        # ? gleiche wie total\n",
    "result_pv_leistung = result_pv['scalars'][(('PV', 'Strom'), 'total')]                       # kW\n",
    "result_pv_flow_generation = result_pv['sequences'][(('PV', 'Strom'), 'flow')]               # kWh/h\n",
    "\n",
    "Ergebnisse_df.loc[\"result_wka_leistung\", \"Wert\"] = result_wka_leistung\n",
