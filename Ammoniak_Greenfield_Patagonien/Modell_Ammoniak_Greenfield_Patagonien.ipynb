     "text": [
      "Levelized Cost of Battery:  25.31 ct/kWh to store\n"
     ]
    }
   ],
   "source": [
    "calc_ucrf_bat = (Eingangsdaten[\"zinssatz_bat\"]*(1+Eingangsdaten[\"zinssatz_bat\"])**Eingangsdaten[\"lebensdauer_bat\"])/((1+Eingangsdaten[\"zinssatz_bat\"])**Eingangsdaten[\"lebensdauer_bat\"]-1)\n",
    "calc_lcoe_bat = (calc_gesamtinvest_bat * calc_ucrf_bat + calc_opex_fix_bat)/result_bat_flowsum_out + Eingangsdaten[\"opex_var_bat\"]      # (€ * %/a + €/a) * a/kWh + €/kWh = €/kWh\n",
    "print(\"Levelized Cost of Battery: \", f\"{calc_lcoe_bat*100:.2f}\", \"ct/kWh to store\")                                               \n",
    "Ergebnisse_df.loc[\"calc_lcoe_bat\", \"Wert\"] = calc_lcoe_bat*100"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4.4.3 Levelized Cost of Electricity\n",
    "Gewichteter Durchschnitt von Wind und PV LOCE zzgl. Batterie LOCE verteilt über die gesamte Erzeugte Strommenge"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 54,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "gewichteter Durchschnitt der Levelized Cost of Electricity inkl Batterie:  2.81 ct/kWh\n"
     ]
    }
   ],
   "source": [
    "calc_lcoe_mix = ((result_pv_flowsum_generation * calc_lcoe_pv) + (result_wka_flowsum_generation*calc_lcoe_wka))/(result_wka_flowsum_generation+result_pv_flowsum_generation)\n",
    "calc_lcoe_bat2 = (calc_gesamtinvest_bat * calc_ucrf_bat + calc_opex_fix_bat)/(result_wka_flowsum_generation+result_pv_flowsum_generation) + Eingangsdaten[\"opex_var_bat\"]      # (€ * %/a + €/a)/(kWh/a+kWh/a) + €/kWh = €/kWh\n",
    "calc_lcoe_mix = calc_lcoe_mix + calc_lcoe_bat2\n",
    "\n",
    "print(\"gewichteter Durchschnitt der Levelized Cost of Electricity inkl Batterie: \", f\"{calc_lcoe_mix*100:.2f}\", \"ct/kWh\")\n",
    "Ergebnisse_df.loc[\"calc_lcoe_mix\", \"Wert\"] = calc_lcoe_mix*100"
   ]
  },
