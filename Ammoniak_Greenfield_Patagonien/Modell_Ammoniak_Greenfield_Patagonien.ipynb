    "calc_lcoh_h2s = (calc_gesamtinvest_h2s * calc_ucrf_h2s + calc_opex_fix_h2s)/result_h2s_flowsum_out                                                           # (€ * %/a + €/a) * a/kg = €/kg\n",
    "print(\"Levelized Cost of Hydrogen Storage: \", f\"{calc_lcoh_h2s:.2f}\", \"€/kg\")\n",
    "Ergebnisse_df.loc[\"calc_lcoh_h2s\", \"Wert\"] = calc_lcoh_h2s                                                                                                                           "
   ]
