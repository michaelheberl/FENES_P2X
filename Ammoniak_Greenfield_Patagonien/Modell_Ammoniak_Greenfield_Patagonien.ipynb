    "print(\"LCOE_WKA (Michi): \", f\"{calc_cost_wka_m*100:.2f}\", \"ct/kWh\") \n",
    "\n",
    "calc_cost_lcoe_m = (annuity_pv*result_pv_leistung+calc_opex_fix_pv+calc_opex_var_pv+annuity_wkaon*result_wka_leistung+calc_opex_fix_wkaon+calc_opex_var_wkaon+annuity_bat_kapa*result_bat_kapa+annuity_bat_leistung*result_bat_leistung+calc_opex_fix_bat)/(result_pv_flowsum_generation+result_wka_flowsum_generation)\n",
    "print(\"LCOE (Michi): \", f\"{calc_cost_lcoe_m*100:.2f}\", \"ct/kWh\") "
   ]
